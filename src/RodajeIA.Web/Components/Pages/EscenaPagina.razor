@page "/escenas/{EscenaId:int}"
@implements IDisposable
@inject IDbContextFactory<RodajeDbContext> Fabrica
@inject RodajeIA.Web.Prompt.ArmadorPrompt Armador
@inject RodajeIA.Web.Prompt.CopiaPrompt Copia
@inject RodajeIA.Web.Generacion.NotificadorGeneracion Notificador
@inject TomasService Tomas
@inject VariantesService Variantes

<PageTitle>@(_escena is null ? "Escena" : $"Escena {_escena.Numero}")</PageTitle>

@if (_escena is null)
{
    <p>No existe la escena.</p>
    return;
}

<nav class="migas" aria-label="Ruta">
    <a href="">Series</a>
    <span class="sep">/</span>
    <a href="episodios/@_escena.EpisodioId">Episodio @_escena.Episodio?.Numero: @_escena.Episodio?.Titulo</a>
</nav>
<header class="encabezado">
    <div>
        <span class="etiqueta-previa">Escena @_escena.Numero · @(_escena.IntExt == IntExt.Int ? "INT." : "EXT.") · @_escena.MomentoDia</span>
        <h1>@_escena.Lugar</h1>
    </div>
    <span class="estado @ClaseEstado(_escena.Estado)">@NombreEstado(_escena.Estado)</span>
</header>

@if (_escena.Estado == EstadoEscena.Error)
{
    <p class="motivo">@_escena.MotivoError</p>
}

<section class="tarjeta">
    <div class="tarjeta-cabecera">
        <div>
            <h2>Personajes y variantes</h2>
            <p class="ayuda">Una variante cambia el aspecto de un personaje solo en esta escena.</p>
        </div>
    </div>
    @if (_personajes.Count == 0)
    {
        <div class="vacio">No se detectaron personajes con hoja en esta escena.</div>
    }
    else
    {
        @if (VariantesBloqueadas)
        {
            <p class="aviso">@VariantesService.EscenaBloqueada</p>
        }

        <ul class="lista">
            @foreach (var hoja in _personajes)
            {
                var variante = _variantes.SingleOrDefault(v => v.HojaId == hoja.Id);
                <li>
                    <div class="principal">
                        <span class="avatar" aria-hidden="true">@(hoja.Nombre.Length > 0 ? char.ToUpperInvariant(hoja.Nombre[0]) : '?')</span>
                        <div>
                            <strong>@hoja.Nombre</strong>
                            <div class="detalle">@(variante is null ? "Hoja base" : $"Variante: {DescribirVariante(variante)}")</div>
                        </div>
                    </div>
                    <div class="acciones">
                        <button class="fantasma" disabled="@VariantesBloqueadas" @onclick="() => AbrirVariante(hoja, variante)">@(variante is null ? "Crear variante" : "Editar variante")</button>
                        @if (variante is not null)
                        {
                            <button class="peligro fantasma" disabled="@VariantesBloqueadas" @onclick="() => EliminarVarianteAsync(variante.Id)">Eliminar variante</button>
                        }
                    </div>
                </li>
            }
        </ul>

        @if (_hojaVariante is not null)
        {
            <form class="formulario subformulario" @onsubmit="GuardarVarianteAsync">
                <div>
                    <h3>Variante de @_hojaVariante.Nombre</h3>
                    <p class="ayuda">Un campo vacío usa el valor de la hoja base.</p>
                </div>
                <div class="fila">
                    <label>Edad <input @bind="_formVariante.Edad" placeholder="@_hojaVariante.Edad" /></label>
                    <label>Peinado <input @bind="_formVariante.Peinado" placeholder="@_hojaVariante.Peinado" /></label>
                </div>
                <label>Vestuario <input @bind="_formVariante.Vestuario" placeholder="@_hojaVariante.Vestuario" /></label>
                <label class="casilla"><input type="checkbox" @bind="_formVariante.ReemplazaHeridas" /> Reemplazar heridas/marcas</label>
                @if (_formVariante.ReemplazaHeridas)
                {
                    <label>Heridas/marcas <span class="opcional">(vacío = sin heridas)</span> <input @bind="_formVariante.HeridasMarcas" /></label>
                }
                <div class="acciones">
                    <button type="submit" class="primario">Guardar variante</button>
                    <button type="button" class="fantasma" @onclick="() => _hojaVariante = null">Cancelar</button>
                </div>
            </form>
        }

        @if (_motivoVariante is not null)
        {
            <p class="motivo">@_motivoVariante</p>
        }
    }
</section>

@if (_escena.Estado == EstadoEscena.Generada)
{
    <section class="tarjeta">
        <div class="tarjeta-cabecera">
            <div>
                <h2>Bloques de tomas</h2>
                <p class="ayuda">Los cambios se guardan al salir de cada campo y actualizan el prompt.</p>
            </div>
        </div>
        @foreach (var bloque in _bloques)
        {
            <div class="bloque">
                <h3>Bloque @bloque.Clip</h3>
                @foreach (var toma in bloque.Tomas)
                {
                    <div class="toma">
                        <strong class="toma-titulo">Toma @toma.Orden</strong>
                        <div class="toma-campos">
                            @foreach (var categoria in RodajeIA.Web.Configuracion.Vocabulario.NombresCategorias)
                            {
                                var actual = Valor(toma, categoria);
                                <label>
                                    @Etiqueta(categoria)
                                    <select value="@(actual ?? "")" @onchange="e => EditarCampoAsync(toma.Id, categoria, e.Value?.ToString())">
                                        @if (!Tomas.EsObligatoria(categoria))
                                        {
                                            <option value="">(sin valor)</option>
                                        }
                                        @if (actual is not null && toma.FueraDeVocabulario.Contains(categoria))
                                        {
                                            <option value="@actual" disabled>@actual</option>
                                        }
                                        @foreach (var opcion in Tomas.Opciones(categoria))
                                        {
                                            <option value="@opcion">@opcion</option>
                                        }
                                    </select>
                                    @if (toma.FueraDeVocabulario.Contains(categoria))
                                    {
                                        <span class="aviso">valor fuera del vocabulario</span>
                                    }
                                </label>
                            }
                        </div>
                        <label>
                            Acción
                            <textarea value="@toma.Accion" @onchange="e => EditarAccionAsync(toma.Id, e.Value?.ToString() ?? string.Empty)"></textarea>
                        </label>
                        @if (toma.Dialogos.Count > 0)
                        {
                            <div class="dialogos">
                                <span>Diálogos</span>
                                @foreach (var dialogo in toma.Dialogos)
                                {
                                    <blockquote>@dialogo</blockquote>
                                }
                            </div>
                        }
                        @if (_motivos.TryGetValue(toma.Id, out var motivo))
                        {
                            <p class="motivo">@motivo</p>
                        }
                    </div>
                }
            </div>
        }
    </section>
}

@if (_prompt is not null)
{
    <section class="tarjeta">
        <div class="tarjeta-cabecera">
            <div>
                <h2>Prompt final</h2>
                <p class="ayuda">Listo para pegar en la IA de video.</p>
            </div>
            <button class="primario" @onclick="CopiarAsync">Copiar prompt</button>
        </div>
        <textarea class="prompt" readonly value="@_prompt" aria-label="Prompt final"></textarea>
        <div class="pie-acciones">
            <span class="meta">@_prompt.Length caracteres</span>
            @if (_resultadoCopia is not null)
            {
                <span class="@(_resultadoCopia.Copiado ? "exito" : "aviso")">@_resultadoCopia.Mensaje</span>
            }
        </div>
    </section>
}

@code {
    [Parameter]
    public int EscenaId { get; set; }

    private Escena? _escena;
    private string? _prompt;
    private RodajeIA.Web.Prompt.ResultadoCopia? _resultadoCopia;
    private IReadOnlyList<BloqueRevision> _bloques = [];
    private readonly Dictionary<int, string> _motivos = [];
    private IReadOnlyList<HojaPersonaje> _personajes = [];
    private IReadOnlyList<VarianteEscena> _variantes = [];
    private HojaPersonaje? _hojaVariante;
    private int? _varianteEditada;
    private FormularioVariante _formVariante = new();
    private string? _motivoVariante;

    private sealed class FormularioVariante
    {
        public string? Edad { get; set; }
        public string? Peinado { get; set; }
        public string? Vestuario { get; set; }
        public bool ReemplazaHeridas { get; set; }
        public string? HeridasMarcas { get; set; }
    }

    private bool VariantesBloqueadas => _escena?.Estado is EstadoEscena.Generando or EstadoEscena.Generada;

    protected override void OnInitialized() => Notificador.EstadoEscenaCambiado += AlCambiarEscena;

    protected override async Task OnParametersSetAsync() => await CargarAsync();

    public void Dispose() => Notificador.EstadoEscenaCambiado -= AlCambiarEscena;

    private void AlCambiarEscena(RodajeIA.Web.Generacion.CambioEstadoEscena cambio)
    {
        if (cambio.EscenaId == EscenaId)
        {
            _ = InvokeAsync(async () =>
            {
                await CargarAsync();
                StateHasChanged();
            });
        }
    }

    private async Task CargarAsync()
    {
        await using var db = await Fabrica.CreateDbContextAsync();
        _escena = await db.Escenas.Include(e => e.Episodio).AsNoTracking().SingleOrDefaultAsync(e => e.Id == EscenaId);
        _personajes = await db.PersonajesEnEscena.Where(p => p.EscenaId == EscenaId).OrderBy(p => p.Orden).Select(p => p.Hoja!).AsNoTracking().ToListAsync();
        _variantes = await Variantes.ListarAsync(EscenaId);
        _prompt = _escena is null ? null : await Armador.ArmarAsync(EscenaId);
        _bloques = _escena is { Estado: EstadoEscena.Generada } ? await Tomas.ObtenerBloquesAsync(EscenaId) : [];
    }

    private static string ClaseEstado(EstadoEscena estado) => estado switch
    {
        EstadoEscena.Generando => "estado-generando",
        EstadoEscena.Generada => "estado-generada",
        EstadoEscena.Error => "estado-error",
        _ => "estado-pendiente",
    };

    private static string NombreEstado(EstadoEscena estado) => estado switch
    {
        EstadoEscena.Generando => "Generando",
        EstadoEscena.Generada => "Generada",
        EstadoEscena.Error => "Error",
        _ => "Pendiente",
    };

    private static string DescribirVariante(VarianteEscena v) => string.Join("; ", new[]
    {
        v.Edad is null ? null : $"edad {v.Edad}",
        v.Peinado is null ? null : $"peinado {v.Peinado}",
        v.Vestuario is null ? null : $"vestuario {v.Vestuario}",
        v.ReemplazaHeridas ? (v.HeridasMarcas is null ? "sin heridas" : $"heridas/marcas {v.HeridasMarcas}") : null,
    }.Where(t => t is not null));

    private void AbrirVariante(HojaPersonaje hoja, VarianteEscena? variante)
    {
        _hojaVariante = hoja;
        _varianteEditada = variante?.Id;
        _motivoVariante = null;
        _formVariante = new FormularioVariante
        {
            Edad = variante?.Edad,
            Peinado = variante?.Peinado,
            Vestuario = variante?.Vestuario,
            ReemplazaHeridas = variante?.ReemplazaHeridas ?? false,
            HeridasMarcas = variante?.HeridasMarcas,
        };
    }

    private async Task GuardarVarianteAsync()
    {
        if (_hojaVariante is null)
        {
            return;
        }

        var datos = new DatosVariante(_formVariante.Edad, _formVariante.Peinado, _formVariante.Vestuario, _formVariante.ReemplazaHeridas, _formVariante.HeridasMarcas);
        var resultado = _varianteEditada is { } id
            ? await Variantes.EditarAsync(id, datos)
            : await Variantes.CrearAsync(EscenaId, _hojaVariante.Id, datos);
        _motivoVariante = resultado.Motivo;
        if (resultado.Ok)
        {
            _hojaVariante = null;
            await CargarAsync();
        }
    }

    private async Task EliminarVarianteAsync(int varianteId)
    {
        _motivoVariante = (await Variantes.EliminarAsync(varianteId)).Motivo;
        await CargarAsync();
    }

    private static string? Valor(TomaRevision toma, string categoria) => categoria switch
    {
        RodajeIA.Web.Configuracion.Vocabulario.Plano => toma.Plano,
        RodajeIA.Web.Configuracion.Vocabulario.Optica => toma.Optica,
        RodajeIA.Web.Configuracion.Vocabulario.Iluminacion => toma.Iluminacion,
        RodajeIA.Web.Configuracion.Vocabulario.Angulo => toma.Angulo,
        _ => toma.Movimiento,
    };

    private static string Etiqueta(string categoria) => categoria switch
    {
        RodajeIA.Web.Configuracion.Vocabulario.Plano => "Plano",
        RodajeIA.Web.Configuracion.Vocabulario.Optica => "Óptica",
        RodajeIA.Web.Configuracion.Vocabulario.Iluminacion => "Iluminación",
        RodajeIA.Web.Configuracion.Vocabulario.Angulo => "Ángulo",
        _ => "Movimiento",
    };

    private async Task EditarCampoAsync(int tomaId, string categoria, string? valor) =>
        await DespuesDeEditarAsync(tomaId, await Tomas.EditarCampoAsync(tomaId, categoria, valor));

    private async Task EditarAccionAsync(int tomaId, string texto) =>
        await DespuesDeEditarAsync(tomaId, await Tomas.EditarAccionAsync(tomaId, texto));

    private async Task DespuesDeEditarAsync(int tomaId, Resultado resultado)
    {
        if (resultado.Motivo is { } motivo)
        {
            _motivos[tomaId] = motivo;
        }
        else
        {
            _motivos.Remove(tomaId);
        }

        _resultadoCopia = null;
        await CargarAsync();
    }

    private async Task CopiarAsync()
    {
        if (_prompt is not null)
        {
            _resultadoCopia = await Copia.CopiarAsync(_prompt);
        }
    }
}
